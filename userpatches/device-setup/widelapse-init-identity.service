[Unit]
Description=Prepare Widelapse persistent SSH identity
RequiresMountsFor=/opt/widelapse
Requires=widelapse-init-directories.service
After=widelapse-init-directories.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/widelapse-init-identity
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

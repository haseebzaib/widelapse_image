#!/bin/bash
set -euo pipefail
mountpoint -q /opt/widelapse
install -d -m 700 /opt/widelapse/identity /opt/widelapse/identity/ssh
# Preserve SSH server identity across A/B switches. Never regenerate intact keys.
key=/opt/widelapse/identity/ssh/ssh_host_ed25519_key
if [[ ! -s $key ]]; then
    rm -f "$key" "$key.pub"
    ssh-keygen -q -t ed25519 -N '' -f "$key"
fi
chmod 600 "$key"

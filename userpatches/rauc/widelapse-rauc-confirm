#!/bin/bash
set -euo pipefail
# Baseline OS checks. Add the application gate before deploying remotely.
mountpoint -q /opt/widelapse
systemctl is-active --quiet ssh.service
/usr/sbin/sshd -t
probe=$(mktemp /opt/widelapse/rauc/.health.XXXXXX)
rm -f "$probe"
[[ $(fw_printenv -n BOOT_ORDER) == 'A B' || $(fw_printenv -n BOOT_ORDER) == 'B A' ]]
if [[ -e /etc/widelapse/require-application-health ]]; then
    test -x /usr/local/bin/widelapse-application-health
    timeout 60 /usr/local/bin/widelapse-application-health
fi
# 'mark-good' resets attempts; it does not activate another slot.
rauc status mark-good booted
